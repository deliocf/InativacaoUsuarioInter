<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-InativacaoUsuarioInter.Service-671e7cc4-d71c-4e03-89b5-b501d130698b</UserSecretsId>
    <RootNamespace>InativacaoUsuarioInter.Service</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="Polly.Core" Version="8.9.1" />
    <!-- Fixa versão corrigida da dependência transitiva do SqlClient (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InativacaoUsuarioInter.Tests.Unit" />
    <InternalsVisibleTo Include="InativacaoUsuarioInter.Tests.Contract" />
    <InternalsVisibleTo Include="InativacaoUsuarioInter.Tests.Integration" />
    <InternalsVisibleTo Include="InativacaoUsuarioInter.Tests.Comum" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuração local (não versionada) com credenciais de teste explícitas (documento-base §4.1). -->
    <!-- Nunca publicada (nem empacotada no MSI): contém a senha explícita do banco local de testes (R-15, T092). -->
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('appsettings.json')" />
    <!-- O exemplo (só placeholders) acompanha a publicação como modelo para a instalação. -->
    <Content Update="appsettings.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

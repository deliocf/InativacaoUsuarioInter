{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Settings": {
    "Instancia": "Inter",
    "IntervalSeconds": 60
  },
  "SharePointFolder": {
    "FolderPathInter": "<CAMINHO_RAIZ_INTER>",
    "FolderPathCondominio": "<CAMINHO_RAIZ_CONDOMINIO>"
  },
  "ConnectionString": {
    "WAccess": "<CONEXAO_WACCESS_DA_INSTALACAO>"
  },
  "Processamento": {
    "DiretorioEstado": "",
    "EstabilizacaoSegundos": 5,
    "MaximoRegistros": 1000,
    "TamanhoMaximoBytes": 1048576,
    "AlertaPendenciaHoras": 24,
    "TimeoutDiarioMs": 5000
  },
  "Resiliencia": {
    "WAccess": {
      "MaxTentativas": 3,
      "AtrasoBaseMs": 1000,
      "AtrasoMaximoMs": 4000,
      "TimeoutConexaoSegundos": 15,
      "TimeoutComandoSegundos": 30,
      "Circuito": { "TaxaFalha": 0.5, "JanelaSegundos": 30, "MinimoChamadas": 3, "PausaSegundos": 60 }
    },
    "Arquivos": {
      "MaxTentativas": 3,
      "AtrasoBaseMs": 1000,
      "AtrasoMaximoMs": 4000,
      "TimeoutOperacaoSegundos": 30,
      "Circuito": { "TaxaFalha": 0.5, "JanelaSegundos": 30, "MinimoChamadas": 3, "PausaSegundos": 60 }
    },
    "Replicacao": {
      "MaxTentativas": 3,
      "AtrasoBaseMs": 1000,
      "AtrasoMaximoMs": 4000,
      "TimeoutOperacaoSegundos": 30,
      "Circuito": { "TaxaFalha": 0.5, "JanelaSegundos": 30, "MinimoChamadas": 3, "PausaSegundos": 60 }
    }
  },
  "Telemetria": {
    "OtlpEndpoint": ""
  },
  "HostOptions": {
    "ShutdownTimeout": "00:00:30"
  }
}
